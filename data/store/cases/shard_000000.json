[
  {
    "id": "case_1791345590834_30fc80",
    "project_id": "proj_1791345590827_4e9791",
    "name": "健康检查接口",
    "description": "演示用例",
    "priority": "P0",
    "tags": [
      "smoke",
      "api"
    ],
    "timeout": 60,
    "enabled": true,
    "steps": [
      {
        "action": "request",
        "method": "GET",
        "url": "/api/health",
        "name": "请求健康检查"
      },
      {
        "action": "assert",
        "type": "status",
        "actual": "${resp.status}",
        "expected": 200,
        "name": "状态码 200"
      },
      {
        "action": "assert",
        "type": "truthy",
        "actual": "${resp.body.ok}",
        "expected": true,
        "name": "返回 ok"
      }
    ],
    "created_at": 1791345590.8346765
  },
  {
